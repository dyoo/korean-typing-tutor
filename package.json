{
  "name": "korean-typing-tutor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "COMMIT_ID=$(git rev-parse HEAD) vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@dannyyoo/korean-tts": "^1.2.5",
    "@huggingface/transformers": "^3.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "knip": {
    "ignore": [
      "public/coi-serviceworker.js"
    ]
  }
}
