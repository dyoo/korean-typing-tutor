    { "id": "pro-1", "moduleId": "korean_proverbs", "type": "sentence", "target": "식은 죽 먹기.", "pronunciation": "sigeun juk meokgi.", "translation": "A piece of cake (Lit: Eating cold porridge)." },
    { "id": "pro-2", "moduleId": "korean_proverbs", "type": "sentence", "target": "티끌 모아 태산.", "pronunciation": "tikkkeul moa taesan.", "translation": "Every little bit counts (Lit: Gathering dust makes a mountain)." },
    { "id": "pro-3", "moduleId": "korean_proverbs", "type": "sentence", "target": "가는 말이 고와야 오는 말이 곱다.", "pronunciation": "ganeun mari gowaya oneun mari gopda.", "translation": "Nice words bring nice words back." },
    { "id": "pro-4", "moduleId": "korean_proverbs", "type": "sentence", "target": "고생 끝에 즐거움이 온다.", "pronunciation": "gosaeng kkeute jeulgeoumi onda.", "translation": "Pleasure comes after hardship." },
