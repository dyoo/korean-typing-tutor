  "items": [
    { "id": "t2p-1", "moduleId": "topik2_passages", "type": "sentence", "target": "한국은 봄, 여름, 가을, 겨울의 사계절이 있습니다. 봄에는 예쁜 꽃이 피고 날씨가 따뜻합니다.", "pronunciation": "hangugeun bom, yeoreum, gaeul, gyeoureui sagaejeori isseumnida. bomeneun yeppeun kkoti pigo nalssiga ttatteut-hamnida.", "translation": "Korea has four seasons: spring, summer, autumn, and winter. In spring, pretty flowers bloom and the weather is warm." },
    { "id": "t2p-2", "moduleId": "topik2_passages", "type": "sentence", "target": "한글은 세종대왕이 1443년에 만든 한국의 문자입니다. 한글은 배우기 쉽고 과학적인 글자입니다.", "pronunciation": "hangeureun sejongdaewangi 1443nyeone mandeun hangugui munjaimnida. hangeureun baeugi swipgo gwahakjeogin geuljaimnida.", "translation": "Hangeul is the Korean alphabet created by King Sejong in 1443. Hangeul is easy to learn and scientific." },
    { "id": "t2p-3", "moduleId": "topik2_passages", "type": "sentence", "target": "지난 주말에 친구와 함께 제주도로 여행을 갔습니다. 제주도의 푸른 바다가 참 아름다웠습니다.", "pronunciation": "jinan jumare chinguwa hamkke jejudoro yeohaengeul gatseumnida. jejudoe pureun badaga cham areumdawotseumnida.", "translation": "Last weekend I went on a trip to Jeju Island with my friend. Jeju Island's blue sea was very beautiful." },
    { "id": "t2p-4", "moduleId": "topik2_passages", "type": "sentence", "target": "저는 아침 일곱 시에 일어나서 운동을 합니다. 아침을 먹고 지하철을 타고 회사에 갑니다.", "pronunciation": "jeoneun achim ilgop sie ireonaseo eundongeul hamnida. achimeul meokgo jihacheoreul tago hoesae gamnida.", "translation": "I wake up at seven in the morning and exercise. After eating breakfast, I take the subway to work." },
    { "id": "t2p-5", "moduleId": "topik2_passages", "type": "sentence", "target": "정직한 나무꾼이 산에서 나무를 하다가, 실수로 쇠도끼를 호수에 빠뜨렸습니다.", "pronunciation": "jeongjikan namukkuni saneseo namureul hadaga, silsuro soedokkireul hosue ppattryeotseumnida.", "translation": "An honest woodcutter accidentally dropped his iron axe into a lake while chopping wood in the mountains." },

    { "id": "tp-1", "moduleId": "topik_grammar", "type": "sentence", "target": "이름이 무엇입니까?", "pronunciation": "ireumi mueosimnikka?", "translation": "What is your name?" },
    { "id": "tp-2", "moduleId": "topik_grammar", "type": "sentence", "target": "저는 학생입니다.", "pronunciation": "jeoneun haksaengimnida.", "translation": "I am a student." },
    { "id": "tp-3", "moduleId": "topik_grammar", "type": "sentence", "target": "어디에 가요?", "pronunciation": "eodie gayo?", "translation": "Where are you going?" },
    { "id": "tp-4", "moduleId": "topik_grammar", "type": "sentence", "target": "학교에 가요.", "pronunciation": "hakgyoe gayo.", "translation": "I am going to school." },
    { "id": "tp-5", "moduleId": "topik_grammar", "type": "sentence", "target": "지금 몇 시예요?", "pronunciation": "jigeum myeot siyeyo?", "translation": "What time is it now?" },
    { "id": "tp-6", "moduleId": "topik_grammar", "type": "sentence", "target": "한국 음식을 좋아해요.", "pronunciation": "hanguk eomsigeul joahaeyo.", "translation": "I like Korean food." },
    { "id": "tp-7", "moduleId": "topik_grammar", "type": "sentence", "target": "버스를 타고 가요.", "pronunciation": "beoseureul tago gayo.", "translation": "I go by bus." },
    { "id": "tp-8", "moduleId": "topik_grammar", "type": "sentence", "target": "오늘 날씨가 따뜻해요.", "pronunciation": "oneul nalssiga ttatteut-haeyo.", "translation": "The weather is warm today." },
    { "id": "tp-9", "moduleId": "topik_grammar", "type": "sentence", "target": "얼마예요?", "pronunciation": "eolmayeyo?", "translation": "How much is it?" },
    { "id": "tp-10", "moduleId": "topik_grammar", "type": "sentence", "target": "이것을 주세요.", "pronunciation": "igeoseul juseyo.", "translation": "Please give me this." },
    { "id": "tp-11", "moduleId": "topik_grammar", "type": "sentence", "target": "화장실이 어디에 있어요?", "pronunciation": "hwajangsiri eodie isseoyo?", "translation": "Where is the restroom?" },
    { "id": "tp-12", "moduleId": "topik_grammar", "type": "sentence", "target": "영화가 재미있었어요.", "pronunciation": "yeonghwaga jaemi-isseosseoyo.", "translation": "The movie was interesting." },
    { "id": "tp-13", "moduleId": "topik_grammar", "type": "sentence", "target": "커피를 마시고 싶어요.", "pronunciation": "keopireul masigo sipeoyo.", "translation": "I want to drink coffee." },
    { "id": "tp-14", "moduleId": "topik_grammar", "type": "sentence", "target": "한국어를 할 수 있어요.", "pronunciation": "hangugeoreul hal su isseoyo.", "translation": "I can speak Korean." },
    { "id": "tp-15", "moduleId": "topik_grammar", "type": "sentence", "target": "비가 와서 집에 있었어요.", "pronunciation": "biga waseo jibe isseosseoyo.", "translation": "Because it rained, I stayed home." },

    { "id": "sj-1", "moduleId": "sejong_phrases", "type": "sentence", "target": "아메리카노 한 잔 주세요.", "pronunciation": "amerikano han jan juseyo.", "translation": "One Americano please." },
    { "id": "sj-2", "moduleId": "sejong_phrases", "type": "sentence", "target": "메뉴판 좀 보여 주세요.", "pronunciation": "menyupan jom boyeo juseyo.", "translation": "Please show me the menu." },
    { "id": "sj-3", "moduleId": "sejong_phrases", "type": "sentence", "target": "이거 얼마예요?", "pronunciation": "igeo eolmayeyo?", "translation": "How much is this?" },
    { "id": "sj-4", "moduleId": "sejong_phrases", "type": "sentence", "target": "카드로 계산할게요.", "pronunciation": "kadeuro gyesanhalgeyo.", "translation": "I will pay by card." },
    { "id": "sj-5", "moduleId": "sejong_phrases", "type": "sentence", "target": "영수증 주세요.", "pronunciation": "yeongsujeung juseyo.", "translation": "Please give me a receipt." },
    { "id": "sj-6", "moduleId": "sejong_phrases", "type": "sentence", "target": "강남역으로 가 주세요.", "pronunciation": "gangnamyeogeuro ga juseyo.", "translation": "Please take me to Gangnam Station." },
    { "id": "sj-7", "moduleId": "sejong_phrases", "type": "sentence", "target": "여기서 내려 주세요.", "pronunciation": "yeogiseo naeryeo juseyo.", "translation": "Please drop me off here." },
    { "id": "sj-8", "moduleId": "sejong_phrases", "type": "sentence", "target": "감기약 좀 주세요.", "pronunciation": "gamgiyak jom juseyo.", "translation": "Please give me cold medicine." },
    { "id": "sj-9", "moduleId": "sejong_phrases", "type": "sentence", "target": "머리가 아파요.", "pronunciation": "meoriga apayo.", "translation": "My head hurts." },
    { "id": "sj-10", "moduleId": "sejong_phrases", "type": "sentence", "target": "사진 좀 찍어 주시겠어요?", "pronunciation": "sajin jom jjigeo jusigesseoyo?", "translation": "Could you take a picture for me?" },

    { "id": "kp-1", "moduleId": "korean_proverbs", "type": "sentence", "target": "식은 죽 먹기.", "pronunciation": "sigeun juk meokgi.", "translation": "A piece of cake (Lit: Eating cold porridge)." },
    { "id": "kp-2", "moduleId": "korean_proverbs", "type": "sentence", "target": "티끌 모아 태산.", "pronunciation": "tikkkeul moa taesan.", "translation": "Every little bit counts (Lit: Gathering dust makes a mountain)." },
    { "id": "kp-3", "moduleId": "korean_proverbs", "type": "sentence", "target": "가는 말이 고와야 오는 말이 곱다.", "pronunciation": "ganeun mari gowaya oneun mari gopda.", "translation": "Nice words bring nice words back." },
    { "id": "kp-4", "moduleId": "korean_proverbs", "type": "sentence", "target": "고생 끝에 즐거움이 온다.", "pronunciation": "gosaeng kkeute jeulgeoumi onda.", "translation": "Pleasure comes after hardship." },
    { "id": "kp-5", "moduleId": "korean_proverbs", "type": "sentence", "target": "시작이 반이다.", "pronunciation": "sijagi banida.", "translation": "Starting is half the battle." },
    { "id": "kp-6", "moduleId": "korean_proverbs", "type": "sentence", "target": "돌다리도 두들겨 보고 건너라.", "pronunciation": "doldarido dudeulgyeo bogo geonneora.", "translation": "Look before you leap (Lit: Tap even a stone bridge before crossing)." },

