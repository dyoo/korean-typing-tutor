{
  "id": "topik_grammar",
  "title": "TOPIK — Sentence Patterns",
  "description": "Essential Korean grammar patterns and daily sentence structures",
  "items": [
    {
      "id": "tp-1",
      "target": "이름이 무엇입니까?",
      "translation": "What is your name?"
    },
    {
      "id": "tp-2",
      "target": "저는 학생입니다.",
      "translation": "I am a student."
    },
    {
      "id": "tp-3",
      "target": "어디에 가요?",
      "translation": "Where are you going?"
    },
    {
      "id": "tp-4",
      "target": "학교에 가요.",
      "translation": "I am going to school."
    },
    {
      "id": "tp-5",
      "target": "지금 몇 시예요?",
      "translation": "What time is it now?"
    },
    {
      "id": "tp-6",
      "target": "한국 음식을 좋아해요.",
      "translation": "I like Korean food."
    },
    {
      "id": "tp-7",
      "target": "버스를 타고 가요.",
      "translation": "I go by bus."
    },
    {
      "id": "tp-8",
      "target": "오늘 날씨가 따뜻해요.",
      "pronunciation": "oneul nalssiga ttatteut-haeyo.",
      "translation": "The weather is warm today."
    },
    {
      "id": "tp-9",
      "target": "커피를 마시고 싶어요.",
      "translation": "I want to drink coffee."
    },
    {
      "id": "tp-10",
      "target": "한국어를 할 수 있어요.",
      "translation": "I can speak Korean."
    },
    {
      "id": "topik_grammar-ext-1",
      "target": "-은/는 -입니다",
      "translation": "Topic Marker & Polite Copula (It is...)"
    },
    {
      "id": "topik_grammar-ext-2",
      "target": "-이/가 아닙니다",
      "translation": "Negative Copula (Is not...)"
    },
    {
      "id": "topik_grammar-ext-3",
      "target": "-을/를 먹습니다",
      "translation": "Object Marker & Eat (Eats something)"
    },
    {
      "id": "topik_grammar-ext-4",
      "target": "-에 갑니다",
      "translation": "Directional Particle (Go to a place)"
    },
    {
      "id": "topik_grammar-ext-5",
      "target": "-에서 공부합니다",
      "translation": "Location Particle (Study at a place)"
    },
    {
